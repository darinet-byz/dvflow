# Header keamanan untuk aset statis aplikasi (04 §9, 06 §9).
#
# Catatan penting: berkas ini hanya berlaku untuk ASET STATIS. Response dari
# Pages Functions (`/api/*`, `/access/*`, `/checkin/*`) mengatur headernya
# sendiri — halaman peserta justru punya CSP yang lebih ketat (tanpa
# `style-src 'unsafe-inline'` untuk skrip, dan dengan `script-src` terbatas).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Kamera hanya untuk origin sendiri — tanpa ini, aplikasi tidak dapat meminta
  # izin kamera sama sekali. Mikrofon dan lokasi tidak dipakai, jadi ditutup.
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  # `script-src 'self'` cukup: index.html hanya memuat berkas hasil build, tidak
  # ada skrip inline. `style-src 'unsafe-inline'` diperlukan karena beberapa
  # komponen memakai atribut style (mis. ukuran spinner/skeleton).
  # `connect-src` mengizinkan Supabase project (baca langsung dari browser, K41).
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.supabase.co; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

# Aset hasil build memakai nama ber-hash, jadi aman di-cache lama.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html tidak boleh di-cache: aplikasi diperbarui lewat deploy baru.
/index.html
  Cache-Control: no-store
